    "허브 주소를 확인하지 못했습니다. (%@)" : {
      "comment" : "Hub discovery: Bonjour service could not be resolved; argument is a technical detail",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
