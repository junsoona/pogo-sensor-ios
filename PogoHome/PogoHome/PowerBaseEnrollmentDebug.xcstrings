        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al salir de la pantalla de la prueba BLE se limpió la prueba que estaba en curso."
          }
        }
      }
    },
    "Bluetooth 상태를 확인하는 중입니다." : {
      "comment" : "DEBUG BLE enrollment test: Bluetooth state unknown",
      "extractionState" : "stale",
      "localizations" : {
