    "16자리 16진수만 입력하세요. 구분자(:, -), *, 모두 0인 값은 쓸 수 없습니다." : {
      "comment" : "DEBUG enrollment test: EUI-64 validation message",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter exactly 16 hex digits. Separators (:, -), * and an all-zero value aren't allowed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce exactamente 16 dígitos hexadecimales. No se admiten separadores (:, -), * ni un valor todo ceros."
          }
        }
      }
    },
