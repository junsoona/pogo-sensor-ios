    },
    "Bluetooth가 꺼져 있습니다. Bluetooth를 켜면 검색을 시작합니다." : {
      "comment" : "DEBUG BLE enrollment test: Bluetooth off",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth is off. Searching starts when you turn Bluetooth on."
          }
        },
