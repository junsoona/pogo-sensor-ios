          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조각보 홈"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description (Power Base enrollment; set in the Debug and Release configurations)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jogakbo Home uses Bluetooth to find and connect to a nearby unregistered Power Base when you add one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jogakbo Home usa Bluetooth para buscar un Power Base cercano sin registrar y conectarse a él cuando añades uno."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조각보 홈 앱은 새 Power Base를 등록할 때 주변의 미등록 Power Base를 찾아 연결하기 위해 Bluetooth를 사용합니다."
          }
        }
      }
    },
    "NSHomeKitUsageDescription" : {
      "comment" : "Privacy - HomeKit Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jogakbo Home needs access to Apple Home to show the status of the Matter and HomeKit devices you added there, and to turn supported devices such as lights, switches and outlets on and off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jogakbo Home necesita acceso a Apple Home para mostrar el estado de los dispositivos Matter y HomeKit que añadiste y para encender y apagar los dispositivos compatibles, como luces, interruptores y enchufes."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조각보 홈 앱은 Apple 홈에 추가한 Matter·HomeKit 기기의 상태를 표시하고, 조명·스위치·콘센트 등 지원되는 기기를 켜고 끄기 위해 Apple 홈 접근 권한이 필요합니다."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jogakbo Home needs local network access to find the OTBR (the Jogakbo hub) on your network and to talk to it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jogakbo Home necesita acceso a la red local para encontrar el OTBR (el hub Jogakbo) de tu red y comunicarse con él."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조각보 홈 앱은 같은 네트워크에 있는 OTBR(조각보 허브)를 찾거나 허브와 통신하기 위해 로컬 네트워크 접근 권한이 필요합니다."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description (reading a Power Base setup QR code; set for the app target in the Debug and Release configurations)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jogakbo Home uses the camera only to read a Power Base's setup QR code and enter its setup code. The camera picture is not saved or sent anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jogakbo Home usa la cámara solo para leer el código QR de configuración de un Power Base e introducir su código de configuración. La imagen de la cámara no se guarda ni se envía."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조각보 홈 앱은 Power Base의 설정 QR 코드를 읽어 설정 코드를 입력할 때만 카메라를 사용합니다. 촬영한 화면은 저장하거나 전송하지 않습니다."
          }
        }
      }
    }
  },
  "version" : "1.0"
}