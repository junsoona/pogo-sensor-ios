        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay dispositivos que mostrar en las habitaciones de Apple Home."
          }
        }
      }
    },
    "Apple 홈이 기기 %lld개를 추가했다고 알렸습니다." : {
      "comment" : "Matter setup finished; number of accessories Apple Home reports as added (plural)",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Apple Home reported %lld accessory added."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Apple Home reported %lld accessories added."
                }
              }
            }
