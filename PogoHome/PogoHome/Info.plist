<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.junsoona.PogoHome.glance</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pogohome</string>
			</array>
		</dict>
	</array>
	<key>PogoBuildCommit</key>
	<string>$(POGO_BUILD_COMMIT)</string>
	<key>PogoBuildDirty</key>
	<string>$(POGO_BUILD_DIRTY)</string>
	<key>PogoBuildID</key>
	<string>$(POGO_BUILD_ID)</string>
	<key>PogoBuildKind</key>
	<string>$(POGO_BUILD_KIND)</string>
	<key>PogoBuildSourceFingerprint</key>
	<string>$(POGO_BUILD_SOURCE_FINGERPRINT)</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_jogakbo._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
