    "아직 값을 읽지 않음" : {
      "comment" : "Apple Home accessory: no value read yet",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No value read yet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no se ha leído ningún valor"
          }
        }
      }
    },
    "아직 수신된 센서 데이터가 없습니다" : {
      "comment" : "Home status detail",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No sensor data received yet"
          }
        },
        "es" : {
