{
  "sourceLanguage" : "ko",
  "strings" : {
    "확인이 필요한 Apple 홈 기기가 있습니다" : {
      "comment" : "Dashboard Apple Home status headline: a device doesn't respond or its last value read failed",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some Apple Home devices need attention"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos dispositivos de Apple Home requieren atención"
          }
        }
      }
    },
    "Apple 홈 기기 값을 다시 읽는 중입니다" : {
      "comment" : "Dashboard Apple Home status headline: value reads are being retried automatically; nothing has failed for good",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reading Apple Home values again"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volviendo a leer los valores de Apple Home"
          }
        }
      }
    },
    "Apple 홈 기기 값을 확인하는 중입니다" : {
      "comment" : "Dashboard Apple Home status headline: first value reads are running",
      "localizations" : {
